# Base URL of the deployed Page Pulse backend (FastAPI on Render).
# Do not include a trailing slash.
VITE_API_BASE_URL=http://127.0.0.1:8000

# Frontend Environment Variables (Vercel)
VITE_API_BASE_URL=https://your-pagepulse-backend.onrender.com
VITE_API_TIMEOUT=45000

# Backend Environment Variables (Render)
ALLOWED_ORIGINS=https://your-pagepulse-frontend.vercel.app
